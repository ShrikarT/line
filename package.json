{
  "name": "line",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "license": "Apache-2.0",
  "description": "Private revolving credit and checkout infrastructure for autonomous agents (Midnight Compact).",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/lib/line/protocol.test.ts src/lib/line/demo.test.ts src/lib/line/encoding.test.ts src/lib/line/compact.test.ts src/lib/line/model.test.ts src/lib/line/leakage.test.ts src/lib/runtime/runtime.test.ts src/lib/runtime/network.integration.test.ts src/lib/security/vault.test.ts mcp/line-mcp.test.mjs",
    "test:line": "node --experimental-strip-types --test src/lib/line/protocol.test.ts src/lib/line/demo.test.ts src/lib/line/encoding.test.ts src/lib/line/compact.test.ts src/lib/line/model.test.ts src/lib/line/leakage.test.ts src/lib/runtime/runtime.test.ts src/lib/runtime/network.integration.test.ts src/lib/security/vault.test.ts",
    "test:leakage": "node --experimental-strip-types --test src/lib/line/leakage.test.ts",
    "compact:compile": "node scripts/compile-compact.mjs --skip-zk contracts/line.compact contracts/managed/line",
    "compact:compile:release": "node scripts/compile-compact.mjs contracts/line.compact contracts/managed/line",
    "compact:test": "node --experimental-strip-types --test src/lib/line/compact.test.ts src/lib/line/encoding.test.ts",
    "contract:deploy": "node scripts/contract-deploy.mjs",
    "contract:join": "node scripts/contract-join.mjs",
    "mcp": "node --experimental-strip-types mcp/line-mcp.mjs",
    "mcp:dev": "node --experimental-strip-types mcp/line-mcp.mjs --dev",
    "mcp:test": "node --experimental-strip-types --test mcp/line-mcp.test.mjs",
    "network:smoke": "node --experimental-strip-types scripts/network-smoke.mjs",
    "local:smoke": "node --experimental-strip-types scripts/local-smoke.mjs",
    "check:keys": "node scripts/check-no-fixture-keys.mjs",
    "test:e2e": "playwright test"
  },
  "compact": {
    "compiler": "0.34.0",
    "language": "0.26.0",
    "runtime": "0.19.0",
    "ledger": "9.1.0.0-rc.3"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.19.0",
    "@midnight-ntwrk/dapp-connector-api": "^4.0.1",
    "@midnight-ntwrk/midnight-js-contracts": "^4.1.1",
    "@midnight-ntwrk/midnight-js-fetch-zk-config-provider": "^4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "^4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "^4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "^4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "^4.1.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "^4.1.1",
    "@midnight-ntwrk/midnight-js-types": "^4.1.1",
    "clsx": "^2.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.5.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.7.0",
    "vite": "^8.2.0",
    "vite-plugin-wasm": "^3.6.0"
  }
}
