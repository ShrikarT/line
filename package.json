{
  "name": "line",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "license": "Apache-2.0",
  "description": "Private revolving credit authorization for autonomous agents (Midnight Compact).",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/lib/line/protocol.test.ts src/lib/line/demo.test.ts src/lib/line/encoding.test.ts src/lib/line/compact.test.ts mcp/line-mcp.test.mjs",
    "test:line": "node --experimental-strip-types --test src/lib/line/protocol.test.ts src/lib/line/demo.test.ts src/lib/line/encoding.test.ts src/lib/line/compact.test.ts",
    "compact:compile": "compact compile --skip-zk contracts/line.compact contracts/managed/line",
    "compact:test": "node --experimental-strip-types --test src/lib/line/compact.test.ts src/lib/line/encoding.test.ts",
    "mcp": "node --experimental-strip-types mcp/line-mcp.mjs",
    "mcp:test": "node --experimental-strip-types --test mcp/line-mcp.test.mjs"
  },
  "compact": {
    "compiler": "0.34.0",
    "language": "0.26.0",
    "runtime": "0.19.0",
    "ledger": "9.1.0.0-rc.3"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.19.0",
    "clsx": "^2.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.5.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.7.0",
    "vite": "^8.2.0"
  }
}
