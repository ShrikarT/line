// Line — private revolving credit authorization (Wave 1)
// Compact language 0.26 / toolchain 0.34.0 / compact-runtime 0.19.0
//
// A successful draw is an issuer-backed, non-replayable authorization.
// It is not an on-chain asset transfer. The merchant is not automatically paid.
//
// Source of truth for commitments:
//   C = persistentCommit<LinePreimage>({ identity: I, limit: L, outstanding: B, epoch }, salt)
// Compact's persistentCommit is the documented commitment primitive. The salt is the opening.
// Domain separation for hashes uses pad(32, "line:…") tags, matching Compact pad().
//
// Authorization is DApp-scoped and hash-based (not a wallet signature):
//   publicKey(sk) = persistentHash([pad(32, "line:pk"), sk])
// Constructor seals issuer pk, merchant pk, and contractDomain.
//
// Status:
//   CLOSED is terminal for setStatus. A new line after CLOSED requires openLine
//   (fresh C0, epoch 0, fresh salt). DEFAULTED may return to OPEN via setStatus
//   without rotating C; draws stay blocked until that happens.
pragma language_version 0.26;

import CompactStandardLibrary;

export enum Status {
  NONE,
  OPEN,
  DEFAULTED,
  CLOSED
}

export struct QuoteMeta {
  expiry: Uint<64>;
  used: Boolean;
}

export struct LinePreimage {
  identity: Bytes<32>;
  limit: Uint<64>;
  outstanding: Uint<64>;
  epoch: Uint<64>;
}

export sealed ledger issuer: Bytes<32>;
export sealed ledger merchant: Bytes<32>;
export sealed ledger contractDomain: Bytes<32>;

export ledger identityCommit: Bytes<32>;
export ledger lineCommit: Bytes<32>;
export ledger lineExpiry: Uint<64>;
export ledger status: Status;
export ledger quotes: Map<Bytes<32>, QuoteMeta>;
export ledger nullifiers: Set<Bytes<32>>;
export ledger clock: Counter;

witness callerSecret(): Bytes<32>;
witness agentSecret(): Bytes<32>;
witness salt(): Bytes<32>;
witness newSalt(): Bytes<32>;
witness invoiceId(): Bytes<32>;
witness quoteNonce(): Bytes<32>;
witness receiptNonce(): Bytes<32>;
witness paymentRef(): Bytes<32>;

circuit publicKey(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "line:pk"), sk]);
}

circuit agentId(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "line:id"), sk]);
}

circuit encodeU64(n: Uint<64>): Bytes<32> {
  return n as Bytes<32>;
}

circuit lineStateCommit(p: LinePreimage, s: Bytes<32>): Bytes<32> {
  return persistentCommit<LinePreimage>(p, s);
}

circuit quoteCommit(
  merchantPk: Bytes<32>,
  inv: Bytes<32>,
  amount: Uint<64>,
  expiry: Uint<64>,
  nonce: Bytes<32>,
  domain: Bytes<32>
): Bytes<32> {
  return persistentHash<Vector<7, Bytes<32>>>([
    pad(32, "line:quote"),
    merchantPk,
    inv,
    encodeU64(amount),
    encodeU64(expiry),
    nonce,
    domain
  ]);
}

circuit drawNullifier(sk: Bytes<32>, Q: Bytes<32>, domain: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<4, Bytes<32>>>([
    pad(32, "line:draw"),
    sk,
    Q,
    domain
  ]);
}

circuit repayNullifier(
  nonce: Bytes<32>,
  I: Bytes<32>,
  C: Bytes<32>,
  amount: Uint<64>,
  payRef: Bytes<32>,
  domain: Bytes<32>
): Bytes<32> {
  return persistentHash<Vector<7, Bytes<32>>>([
    pad(32, "line:repay"),
    nonce,
    I,
    C,
    encodeU64(amount),
    payRef,
    domain
  ]);
}

constructor(issuerSk: Bytes<32>, merchantSk: Bytes<32>) {
  const ipk = publicKey(issuerSk);
  const mpk = publicKey(merchantSk);
  issuer = disclose(ipk);
  merchant = disclose(mpk);
  contractDomain = disclose(persistentHash<Vector<3, Bytes<32>>>([
    pad(32, "line:domain"),
    ipk,
    mpk
  ]));
  status = Status.NONE;
}

circuit requireIssuer(): [] {
  assert(issuer == publicKey(callerSecret()), "not issuer");
}

circuit requireMerchant(): [] {
  assert(merchant == publicKey(callerSecret()), "not merchant");
}

export circuit openLine(limit: Uint<64>, expiry: Uint<64>): [] {
  requireIssuer();
  assert(status == Status.NONE || status == Status.CLOSED, "line already open");
  assert(limit > 0, "limit");
  assert(expiry > clock, "expiry");
  const k = agentSecret();
  const I = agentId(k);
  const p = LinePreimage {
    identity: I,
    limit: limit,
    outstanding: 0,
    epoch: 0
  };
  const C0 = lineStateCommit(p, salt());
  identityCommit = disclose(I);
  lineCommit = disclose(C0);
  lineExpiry = disclose(expiry);
  status = Status.OPEN;
  clock.increment(1);
}

export circuit postQuote(amount: Uint<64>, expiry: Uint<64>): [] {
  requireMerchant();
  assert(amount > 0, "zero");
  assert(expiry > clock, "expiry");
  const Q = quoteCommit(
    merchant,
    invoiceId(),
    amount,
    expiry,
    quoteNonce(),
    contractDomain
  );
  const pubQ = disclose(Q);
  assert(!quotes.member(pubQ), "quote exists");
  quotes.insert(pubQ, QuoteMeta { expiry: disclose(expiry), used: false });
  clock.increment(1);
}

export circuit draw(
  quoteCommitPublic: Bytes<32>,
  limit: Uint<64>,
  outstanding: Uint<64>,
  epoch: Uint<64>,
  amount: Uint<64>
): [] {
  assert(status == Status.OPEN, "status");
  assert(lineExpiry > clock, "line expired");
  const k = agentSecret();
  const I = agentId(k);
  assert(I == identityCommit, "agent");
  const p = LinePreimage {
    identity: I,
    limit: limit,
    outstanding: outstanding,
    epoch: epoch
  };
  assert(lineStateCommit(p, salt()) == lineCommit, "stale");
  const Q = disclose(quoteCommitPublic);
  assert(quotes.member(Q), "quote");
  const meta = quotes.lookup(Q);
  assert(!meta.used, "used");
  assert(meta.expiry > clock, "expired");
  const recon = quoteCommit(
    merchant,
    invoiceId(),
    amount,
    meta.expiry,
    quoteNonce(),
    contractDomain
  );
  assert(disclose(recon) == Q, "quote preimage");
  assert(amount > 0, "zero");
  const nextB = outstanding + amount;
  assert(nextB >= outstanding, "overflow");
  assert(nextB <= limit, "capacity");
  const N = drawNullifier(k, Q, contractDomain);
  const pubN = disclose(N);
  assert(!nullifiers.member(pubN), "nullifier");
  quotes.insert(Q, QuoteMeta { expiry: meta.expiry, used: true });
  nullifiers.insert(pubN);
  const p2 = LinePreimage {
    identity: I,
    limit: limit,
    outstanding: nextB as Uint<64>,
    epoch: (epoch + 1) as Uint<64>
  };
  lineCommit = disclose(lineStateCommit(p2, newSalt()));
  clock.increment(1);
}

export circuit acknowledgeRepayment(
  limit: Uint<64>,
  outstanding: Uint<64>,
  epoch: Uint<64>,
  amount: Uint<64>,
  receiptExpiry: Uint<64>
): [] {
  requireIssuer();
  assert(status == Status.OPEN || status == Status.DEFAULTED, "status");
  const I = identityCommit;
  const C = lineCommit;
  const p = LinePreimage {
    identity: I,
    limit: limit,
    outstanding: outstanding,
    epoch: epoch
  };
  assert(lineStateCommit(p, salt()) == C, "stale");
  assert(amount > 0, "zero");
  assert(amount <= outstanding, "range");
  assert(receiptExpiry > clock, "expiry");
  const N = repayNullifier(
    receiptNonce(),
    I,
    C,
    amount,
    paymentRef(),
    contractDomain
  );
  const pubN = disclose(N);
  assert(!nullifiers.member(pubN), "receipt used");
  nullifiers.insert(pubN);
  const p2 = LinePreimage {
    identity: I,
    limit: limit,
    outstanding: (outstanding - amount) as Uint<64>,
    epoch: (epoch + 1) as Uint<64>
  };
  lineCommit = disclose(lineStateCommit(p2, newSalt()));
  clock.increment(1);
}

export circuit setStatus(next: Status): [] {
  requireIssuer();
  const n = disclose(next);
  assert(status != Status.NONE, "no line");
  assert(n != Status.NONE, "bad status");
  assert(status != Status.CLOSED, "closed");
  if (n == Status.OPEN) {
    assert(status == Status.OPEN || status == Status.DEFAULTED, "only defaulted reopens");
  }
  status = n;
  clock.increment(1);
}
