# Copy to .env.local. Server-side configuration; never use VITE_ credentials.
LINE_PUBLIC_ORIGIN=http://127.0.0.1:3000
LINE_ORGANIZATION_MODE=wallet-only
MIDNIGHT_BLOCKFROST_PROJECT_ID=

