# Source fingerprints and proving-release provenance use exact bytes.
# Keep Compact sources identical across Windows and Linux checkouts.
*.compact text eol=lf
contracts/managed/** text eol=lf
scripts/compile-compact.mjs text eol=lf
*.mjs text eol=lf
src/lib/line/encoding.ts text eol=lf
tests/fixtures/private-offer-public-pairs/native-proof.json text eol=lf
# The funded test profile pins the exact CRLF source bytes used for its keys.
# Preserve them across checkouts; normalization requires a release migration.
contracts/experimental/line-test-settlement.compact -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
